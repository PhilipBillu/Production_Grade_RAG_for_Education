# ==============================================================================
# Environment Configuration for RAG Ingestion Pipeline
# ==============================================================================

# Weaviate Connection Settings (Local Docker Instance)
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051

# Hugging Face Settings (Optional - leave empty for local sentence-transformers inference)
HUGGINGFACE_APIKEY=

# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Ingestion Settings
INDEX_NAME=DocumentChunk
CHUNK_SIZE=800
CHUNK_OVERLAP=100
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Groq LLM Generation Settings (Phase 3)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
REFUSAL_THRESHOLD=0.4

